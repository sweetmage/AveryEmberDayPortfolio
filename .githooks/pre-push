#!/bin/sh
# --- Netlify deploy pause (added 2026-07-26) -------------------------------
# The Netlify team is out of credits; production deploys are paused until the
# billing cycle resets. `portfoliowebsite` is the branch Netlify deploys from,
# so pushing it is the one action that can touch the live URL. Block it until
# the reset date. This guard EXPIRES BY ITSELF on 2026-08-07 - no cleanup
# needed. To override deliberately: git push --no-verify
PAUSE_UNTIL=20260807
TODAY=$(date +%Y%m%d)

# pre-push receives refs on stdin, and `git lfs pre-push` below needs them too,
# so capture once and replay.
HOOK_STDIN=$(cat)

if [ "$TODAY" -lt "$PAUSE_UNTIL" ]; then
  if printf '%s\n' "$HOOK_STDIN" | grep -q 'refs/heads/portfoliowebsite'; then
    printf >&2 '\n'
    printf >&2 'BLOCKED: push to portfoliowebsite is paused until 2026-08-07.\n'
    printf >&2 '\n'
    printf >&2 '  portfoliowebsite is the branch Netlify deploys to the live URL.\n'
    printf >&2 '  Netlify credits are exhausted (300/month, 15 per production\n'
    printf >&2 '  deploy); deploys resume 2026-08-07. See LOGBOOK Entry 104.\n'
    printf >&2 '\n'
    printf >&2 '  Work on develop instead:  git push origin develop\n'
    printf >&2 '  Deliberate override:      git push --no-verify\n'
    printf >&2 '\n'
    exit 1
  fi
fi
# --- end deploy pause ------------------------------------------------------

command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
printf '%s\n' "$HOOK_STDIN" | git lfs pre-push "$@"
