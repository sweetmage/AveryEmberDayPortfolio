{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "-l",
        "3478",
        "."
      ],
      "port": 3478
    },
    {
      "name": "portfolio-next",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "portfolio-export",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npm run build:next && npx serve out -l 4400"
      ],
      "port": 4400
    }
  ]
}
