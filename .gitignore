# Ignore nested git repos (standalone projects with their own remotes)
/git/portfolio/
/projects/RNG/

# Dependencies
/node_modules/

# Temporary / debug files
/tmp/
*.log

# One-off scripts
/run_git_commands.py

# Cross-target sync (personal task IDs, auth tokens)
/docs/sync/mapping.json
/docs/sync/*-manifest.json
/docs/sync/google-docs.json
.env

# Node / Tailwind build pipeline (app.css → style.css)
# NOTE: style.css is intentionally NOT ignored — it's the compiled Tailwind
# output for the LEGACY root site (index.html, gallery/, projects/*.html).
# Netlify no longer ships it: netlify.toml runs `next build` and publishes
# `out/`, so the deployed app's CSS comes from app/globals.css instead. This
# comment used to claim `publish = "."` with no build command, which stopped
# being true at the Next.js migration (Entry 066); corrected 2026-07-31.

# Next.js build output
/.next/
/out/

# Auto-generated by next dev / next build. It oscillates between
# ./.next/types/ and ./out/types/ depending on which ran last, so tracking it
# dirties the tree on every build. Next.js's own template ignores it, and the
# file itself says "should not be edited".
next-env.d.ts

# Playwright test artifacts
/test-results/

# shxdowmap seed cache (1MB+ repomix dump, rebuilt on demand by `shxdowmap refresh`)
/.shxdowmap/

# Scratch, untracked 2026-08-03 (Entry 116). One-off Python screenshot/inspection
# scripts and Playwright throwaways; nothing imports any of it. They were showing
# up as code directories in the ARCHITECTURE.md module map, where they mislead.
/output/
/Script.js
